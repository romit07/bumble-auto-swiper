# Copy to config.env and fill in your own values:  cp config.example.env config.env
# Every script in scripts/ reads this file (or the same variables from the environment).
# config.env is in .gitignore - never commit it.

# --- Phone (Termux mode: nothing to set; remote mode: reach it over Tailscale) ---
# PHONE_HOST: leave EMPTY when running in Termux on the phone itself (defaults to 127.0.0.1).
# Laptop/remote mode only: the phone's Tailscale IP or MagicDNS name (`tailscale status`).
PHONE_HOST=
ADB_PORT=5555                     # fixed port after `adb tcpip 5555`
ADB_TIMEOUT=25                    # seconds; every adb call is wrapped in `timeout`

# Remote mode + JUDGE=local only: SSH into Termux to run the on-device judge
SSH_PORT=8022                     # Termux sshd default
SSH_USER=                         # output of `whoami` inside Termux, e.g. u0_aXXX
SSH_KEY=~/.ssh/android_termux     # private key whose .pub is in Termux ~/.ssh/authorized_keys

# --- Session ---
MAX_PROFILES=50                   # hard cap of decisions per session (keep it modest)
STATE_DIR=./state                 # session log, counter, temporary captures (gitignored)

# --- Bumble app (change only if the app's UI changes) ---
BUMBLE_PKG=com.bumble.app
BUMBLE_ACTIVITY=com.bumble.app.ui.main.AppMainActivity
CARD_MARKER='main photo'          # text/content-desc that is only present on a profile card
LIKE_DESC=Like                    # content-desc of the Like button
# Stop words: if the card is missing and any of these are on screen, the run stops.
BLOCKER_REGEX='limit|out of likes|come back|premium|subscribe|upgrade|verif|banned|suspend|blocked|warning|log in|sign in'

# --- Capture (screenrecord while scrolling, then an ffmpeg montage) ---
REC_WIDTH=288                     # small recording = fast pull, still enough to judge build
SCROLLS=6                         # slow scrolls through the profile while recording
REC_SECONDS=13
SWIPE_MS=1200                     # slow scroll swipes (ms): look human and do not skip photos

# --- Judge ---
# JUDGE=agent : an AI agent running SKILL.md looks at the montage itself (what worked best)
# JUDGE=api   : any OpenAI-compatible vision endpoint (scripts/judge-api.py)
# JUDGE=local : on-device SmolVLM-256M via llama.cpp in Termux (~50 s per image, rough)
JUDGE=local                       # Termux default. Use agent or api from a laptop/agent.
PROMPT_FILE=./prompt.example.txt
JUDGE_API_URL=https://api.openai.com/v1/chat/completions
JUDGE_API_KEY=                    # your vision API key (keep config.env private)
JUDGE_MODEL=                      # any vision-capable model name
# On-device judge (termux/judge-profile.sh)
MODEL_DIR=~/models
LLAMA_THREADS=4
